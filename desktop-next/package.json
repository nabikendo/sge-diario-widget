{
  "name": "sge-diario-desktop-next",
  "version": "3.0.0",
  "private": true,
  "description": "SGE Diário Desktop autônomo: entra no SGE e lê os dados sozinho",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "test": "node --test tests/*.test.js",
    "build:win": "vite build && electron-builder --win nsis --x64 --publish never && node scripts/garantir-latest-yml.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "cheerio": "^1.0.0",
    "electron-updater": "^6.8.11",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.500.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "br.to.seduc.sgediariowidget.desktop",
    "productName": "SGE Diário Desktop",
    "directories": {
      "output": "release-dist"
    },
    "files": [
      "electron/**",
      "dist/**",
      "assets/sge-diario.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/sge-diario.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "SGE-Diario-Desktop-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "nabikendo",
      "repo": "sge-diario-widget",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SGE Diário",
      "uninstallDisplayName": "SGE Diário Desktop",
      "deleteAppDataOnUninstall": false
    }
  }
}
