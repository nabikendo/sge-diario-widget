<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_preview_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SGE DIÁRIO"
        android:textColor="@color/widget_preview_secondary" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:text="Resumo do diário" android:textColor="@color/widget_preview_text" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:text="Pendências · A conferir" android:textColor="@color/widget_preview_text" android:textSize="15sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="Toque para abrir o painel"
        android:textColor="@color/widget_preview_secondary" android:textSize="11sp" />
</LinearLayout>
